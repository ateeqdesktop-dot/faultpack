{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ateeqdesktop-dot/faultpack/blob/main/docs/faultpack.schema.json",
  "title": "FaultPack manifest",
  "type": "object",
  "required": ["format_version", "pack_id", "command", "environment", "observed", "expectation"],
  "properties": {
    "format_version": {"const": "0.1"},
    "pack_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "command": {"type": "object", "required": ["argv", "cwd", "timeout_seconds"], "properties": {"argv": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "cwd": {"type": "string"}, "timeout_seconds": {"type": "number", "exclusiveMinimum": 0}}},
    "environment": {"type": "object", "required": ["os", "platform", "python"], "properties": {"os": {"type": "string"}, "platform": {"type": "string"}, "python": {"type": "string"}, "variables": {"type": "object"}}},
    "input_files": {"type": "array", "items": {"type": "object", "required": ["path", "sha256"], "properties": {"path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}},
    "observed": {"type": "object", "required": ["status", "duration_ms", "stdout_sha256", "stderr_sha256"], "properties": {"status": {"enum": ["passed", "failed", "timeout", "error"]}, "exit_code": {"type": ["integer", "null"]}, "duration_ms": {"type": "integer", "minimum": 0}, "stdout_sha256": {"type": "string"}, "stderr_sha256": {"type": "string"}}},
    "expectation": {"type": "object", "properties": {"exit_code": {"type": ["integer", "null"]}, "stdout_regex": {"type": ["string", "null"]}, "stderr_regex": {"type": ["string", "null"]}}}
  },
  "additionalProperties": false
}
