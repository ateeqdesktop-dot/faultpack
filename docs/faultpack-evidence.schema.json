{
  "$defs": {
    "InteropEvent": {
      "additionalProperties": false,
      "properties": {
        "sequence": {
          "minimum": 1,
          "title": "Sequence",
          "type": "integer"
        },
        "kind": {
          "enum": [
            "agent",
            "model",
            "tool_call",
            "tool_result",
            "retrieval",
            "policy",
            "evaluation",
            "assertion",
            "annotation",
            "unknown"
          ],
          "title": "Kind",
          "type": "string"
        },
        "source_kind": {
          "maxLength": 96,
          "minLength": 1,
          "title": "Source Kind",
          "type": "string"
        },
        "name": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "trace_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trace Id"
        },
        "span_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Span Id"
        },
        "parent_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Id"
        },
        "status": {
          "default": "unknown",
          "enum": [
            "passed",
            "failed",
            "timeout",
            "error",
            "unknown"
          ],
          "title": "Status",
          "type": "string"
        },
        "duration_ms": {
          "anyOf": [
            {
              "maximum": 86400000,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration Ms"
        },
        "payload_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Payload Sha256"
        },
        "attributes": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Attributes",
          "type": "object"
        }
      },
      "required": [
        "sequence",
        "kind",
        "source_kind",
        "name"
      ],
      "title": "InteropEvent",
      "type": "object"
    },
    "InteropFinding": {
      "additionalProperties": false,
      "properties": {
        "rule_id": {
          "pattern": "^[a-z0-9]+(?:\\.[a-z0-9_-]+)+$",
          "title": "Rule Id",
          "type": "string"
        },
        "severity": {
          "enum": [
            "info",
            "warning",
            "error"
          ],
          "title": "Severity",
          "type": "string"
        },
        "message": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "path": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "remediation": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Remediation",
          "type": "string"
        }
      },
      "required": [
        "rule_id",
        "severity",
        "message",
        "path",
        "remediation"
      ],
      "title": "InteropFinding",
      "type": "object"
    },
    "InteropSource": {
      "additionalProperties": false,
      "properties": {
        "adapter": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Adapter",
          "type": "string"
        },
        "input_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Input Sha256",
          "type": "string"
        },
        "producer": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Producer"
        }
      },
      "required": [
        "adapter",
        "input_sha256"
      ],
      "title": "InteropSource",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "faultpack-evidence",
      "default": "faultpack-evidence",
      "title": "Format",
      "type": "string"
    },
    "format_version": {
      "const": "0.1",
      "default": "0.1",
      "title": "Format Version",
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/InteropSource"
    },
    "event_count": {
      "maximum": 10000,
      "minimum": 1,
      "title": "Event Count",
      "type": "integer"
    },
    "events": {
      "items": {
        "$ref": "#/$defs/InteropEvent"
      },
      "maxItems": 10000,
      "minItems": 1,
      "title": "Events",
      "type": "array"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/InteropFinding"
      },
      "maxItems": 10000,
      "title": "Findings",
      "type": "array"
    },
    "bundle_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Bundle Sha256",
      "type": "string"
    }
  },
  "required": [
    "source",
    "event_count",
    "events",
    "bundle_sha256"
  ],
  "title": "FaultPack Evidence Bundle",
  "type": "object",
  "$id": "https://github.com/ateeqdesktop-dot/faultpack/blob/main/docs/faultpack-evidence.schema.json"
}
